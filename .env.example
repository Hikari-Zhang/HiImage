# Web UI is bound to loopback by default. Set WEB_HOST=0.0.0.0 only when
# access from other machines is intentionally required.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Per backend process: one inference runs and this many may wait (0-32).
HIIMAGE_MAX_PENDING_INFERENCE=4

# Empty means WebSocket same-origin only. Use a comma-separated explicit
# allowlist when additional origins are required.
HIIMAGE_WS_ORIGINS=

# Local development does not trust client-supplied proxy headers. Enable only
# behind a reverse proxy that overwrites X-Forwarded-*.
HIIMAGE_TRUST_PROXY_HEADERS=false

# CPU stack:
#   docker compose up --build
#
# NVIDIA GPU stack (does not start the CPU backend):
#   docker compose --profile gpu up --build backend-gpu web-gpu
