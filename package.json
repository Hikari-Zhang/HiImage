{
  "name": "hiimage-workspace",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "dev:check": "node scripts/dev.js --check",
    "backend:dev": "node scripts/dev.js --backend-only",
    "frontend:dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm run test:scripts && npm run test:frontend && npm run test:backend",
    "test:scripts": "node --test scripts/tests/dev-app.test.js scripts/tests/dev-logic.test.js scripts/tests/python-env.test.js scripts/tests/setup-runner.test.js",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "node scripts/python.js -m pytest tests backend/tests",
    "preview": "npm run build && node scripts/dev.js --mode preview",
    "start": "node scripts/dev.js --mode preview",
    "backend:start": "node scripts/dev.js --mode preview --backend-only",
    "frontend:preview": "npm --prefix frontend run preview"
  }
}
